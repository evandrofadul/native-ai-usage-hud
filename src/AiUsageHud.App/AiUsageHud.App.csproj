<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- The DPI manifest is a Windows concept; only embed it for Windows (and design-time)
         builds so a linux-x64 publish doesn't carry it. -->
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Embeds the Win32 icon resource into the app .exe (Explorer / taskbar / pinned).
         Ignored by non-Windows apphosts, so it is safe for the linux-x64 publish too. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Cross-platform head. The Win32 tray + System.Drawing icon path is gated to Windows
         at runtime (WindowsTrayController / OperatingSystem.IsWindows()); CA1416 is silenced
         because those platform-specific calls are reached only on Windows. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Native AOT publish. Surfaces trim/AOT analyzer warnings at build time and
         runs the ILC linker on `dotnet publish -r win-x64`. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Size/perf switches applied only to RID-targeted publishes (e.g. `-r win-x64`), so a
       bare `dotnet publish -c Release -r win-x64` yields the optimized AOT binary with no
       extra -p: flags. Guarded by RuntimeIdentifier so plain `dotnet run` / Debug keep
       stack traces, debugger support and the host culture. InvariantGlobalization drops
       ICU (formatting uses the invariant culture in the published app). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>AiUsageHud</AssemblyName>
    <AssemblyTitle>AI Usage HUD</AssemblyTitle>
    <Product>AI Usage HUD</Product>
    <Description>System-tray monitor for Anthropic Claude, OpenAI Codex, GitHub Copilot and Google Gemini plan usage.</Description>
    <Authors>Evandro Fadul</Authors>
    <Company>Evandro Fadul</Company>
    <Copyright>Copyright © 2026 Evandro Fadul</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.17" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <!-- App assets embedded as Avalonia resources (avares://AiUsageHud/Assets/...).
       The window icon (MainWindow Icon="/Assets/icon.ico") uses this on both heads. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiUsageHud.Core\AiUsageHud.Core.csproj" />
    <ProjectReference Include="..\AiUsageHud.Presentation\AiUsageHud.Presentation.csproj" />
  </ItemGroup>

  <!-- Tomlyn is only used through its document model (Toml.ToModel → TomlTable, with
       manual key reads); its reflection-based typed-model path is never called. Root
       the assembly so the AOT trimmer keeps it intact (silences IL2104, guarantees
       the TOML parser works at runtime). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Tomlyn" />
  </ItemGroup>

</Project>
