<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gruvbox Light — the light counterpart to Gruvbox Dark. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#FBF1C7"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#F2E5BC"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#EBDBB2"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#D5C4A1"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#3C3836"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#7C6F64"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#458588"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#D5C4A1"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#EBDBB2"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#98971A"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#D79921"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#D65D0E"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#CC241D"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#CC241D"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#9D0006"/>
</ResourceDictionary>
