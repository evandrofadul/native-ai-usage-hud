<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AiUsageBar.AvaloniaApp.Converters">

    <!-- Hand-authored control styles — the Avalonia port of the WPF Themes/Controls.xaml.
         SimpleTheme (App.axaml) only supplies plumbing for controls we don't draw
         (ScrollViewer/ItemsControl); every visible control below is fully re-templated
         to match the WPF look. Palette brushes are pulled via DynamicResource so styles
         re-render when AvaloniaThemeService swaps the palette. -->

    <Styles.Resources>
        <ResourceDictionary>

            <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
            <conv:EnumLabelConverter x:Key="EnumLabel"/>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:EqualsConverter x:Key="Eq"/>
            <conv:ThemeIdToOptionConverter x:Key="ThemeIdToOption"/>

            <!-- ============================================================
                 Button — flat, rounded, accent hover
                 ============================================================ -->
            <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:focus /template/ Border#Bd">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:focus">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.5"/>
                </Style>
            </ControlTheme>

            <!-- Primary / accent button (Settings "Save"). Hover keeps the accent fill
                 (just nudges opacity). -->
            <ControlTheme x:Key="AccentButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Opacity" Value="0.88"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Opacity" Value="0.75"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.5"/>
                </Style>
            </ControlTheme>

            <!-- ============================================================
                 Window controls — compact square icon buttons
                 ============================================================ -->
            <ControlTheme x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="0" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
                </Style>
            </ControlTheme>

            <!-- Toggle variant of the window control button: accent foreground when checked. -->
            <ControlTheme x:Key="WindowToggleButton" TargetType="ToggleButton">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="0" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:checked">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
                </Style>
            </ControlTheme>

            <!-- Same shape, but the close button turns red on hover. -->
            <ControlTheme x:Key="WindowCloseButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="0,4,0,0" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                </Style>
            </ControlTheme>

            <!-- Compact, rounded arrow button for the tray menu's vendor switcher. -->
            <ControlTheme x:Key="MenuArrowButton" TargetType="Button">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Style>
            </ControlTheme>

            <!-- ============================================================
                 Toggle switch — Win11-style pill with a sliding accent knob
                 ============================================================ -->
            <ControlTheme x:Key="ToggleSwitch" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Track" CornerRadius="11" BorderThickness="1" BorderBrush="Transparent"
                                Background="{DynamicResource Bg3Brush}">
                            <Ellipse Name="Knob" Width="14" Height="14"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="4,0,0,0"
                                     Fill="{DynamicResource DimBrush}"
                                     RenderTransform="translateX(0)">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform"
                                                                       Duration="0:0:0.16" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Track">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:checked /template/ Border#Track">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:checked /template/ Ellipse#Knob">
                    <Setter Property="Fill" Value="{DynamicResource BgBrush}"/>
                    <Setter Property="RenderTransform" Value="translateX(18px)"/>
                </Style>
            </ControlTheme>

            <!-- ============================================================
                 Slider — flat rounded track, accent fill, accent thumb with hover halo
                 ============================================================ -->
            <ControlTheme x:Key="SliderFillButton" TargetType="RepeatButton">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Height="5" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="SliderEmptyButton" TargetType="RepeatButton">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="SliderThumb" TargetType="Thumb">
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Width="16" Height="16">
                            <Ellipse Name="Halo" Margin="-5" Opacity="0" Fill="{DynamicResource AccentBrush}"/>
                            <Ellipse Name="Dot" Fill="{DynamicResource AccentBrush}"
                                     Stroke="{DynamicResource BgBrush}" StrokeThickness="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Ellipse#Halo">
                    <Setter Property="Opacity" Value="0.18"/>
                </Style>
                <Style Selector="^:pressed /template/ Ellipse#Halo">
                    <Setter Property="Opacity" Value="0.28"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="ThemedSlider" TargetType="Slider">
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="TickFrequency" Value="1"/>
                <Setter Property="SmallChange" Value="1"/>
                <Setter Property="LargeChange" Value="10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Bg3Brush}"/>
                            <Track Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SliderFillButton}"/>
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource SliderEmptyButton}"/>
                                </Track.IncreaseButton>
                                <Track.Thumb>
                                    <Thumb Theme="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <!-- ============================================================
                 Usage gauge — rounded track + rounded fill, tinted by severity
                 ============================================================ -->
            <ControlTheme x:Key="UsageGauge" TargetType="ProgressBar">
                <Setter Property="Height" Value="8"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="Background" Value="{DynamicResource BarEmptyBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource SevLowBrush}"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Border Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^.sevMid">
                    <Setter Property="Foreground" Value="{DynamicResource SevMidBrush}"/>
                </Style>
                <Style Selector="^.sevHigh">
                    <Setter Property="Foreground" Value="{DynamicResource SevHighBrush}"/>
                </Style>
                <Style Selector="^.sevCritical">
                    <Setter Property="Foreground" Value="{DynamicResource SevCriticalBrush}"/>
                </Style>
            </ControlTheme>

            <!-- ============================================================
                 Tabs — pill headers + rounded content card
                 ============================================================ -->
            <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="6" Margin="0,0,4,0" Padding="14,7,14,17"
                                Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                </Style>
                <Style Selector="^:selected /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
                </Style>
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid RowDefinitions="Auto,*">
                            <ItemsPresenter Name="PART_ItemsPresenter" Grid.Row="0"
                                            Margin="0,0,0,-10"
                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            <Border Grid.Row="1" Background="{DynamicResource Bg2Brush}" CornerRadius="6">
                                <ContentPresenter Name="PART_SelectedContentHost"
                                                  Content="{TemplateBinding SelectedContent}"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter>
                <Setter Property="ItemsPanel">
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter>
            </ControlTheme>

            <!-- ============================================================
                 ComboBox — fully themed: box, chevron, dropdown popup, items
                 ============================================================ -->
            <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" Margin="3,1" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:selected /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                </Style>
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid>
                            <Border Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <ContentControl Grid.Column="0" Margin="10,0,0,0"
                                                    Content="{TemplateBinding SelectionBoxItem}"
                                                    ContentTemplate="{TemplateBinding ItemTemplate}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    IsHitTestVisible="False"/>
                                    <Path Name="Arrow" Grid.Column="1" Margin="0,0,12,0"
                                          Width="10" Height="6" Stretch="Fill"
                                          Fill="{DynamicResource DimBrush}" Data="M 0 0 L 5 5 L 10 0 Z"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding $parent[ComboBox]}"
                                   Placement="Bottom"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding $parent[ComboBox].Bounds.Width}"
                                        Background="{DynamicResource Bg2Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer Margin="0,3">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:pointerover /template/ Path#Arrow">
                    <Setter Property="Fill" Value="{DynamicResource FgBrush}"/>
                </Style>
                <Style Selector="^:dropdownopen /template/ Border#Bd">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:dropdownopen /template/ Path#Arrow">
                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                </Style>
                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.5"/>
                </Style>
            </ControlTheme>

            <!-- Tray context-menu item (used by the custom tray popup window). -->
            <ControlTheme x:Key="TrayMenuItem" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="4" Margin="0,1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Style>
                <Style Selector="^:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Style>
            </ControlTheme>

            <!-- ============================================================
                 Thin dark scrollbar — pill thumb, hidden track buttons
                 ============================================================ -->
            <ControlTheme x:Key="ScrollThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Bd" CornerRadius="3" Background="{DynamicResource BorderBrush}"/>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Bd">
                    <Setter Property="Background" Value="{DynamicResource DimBrush}"/>
                </Style>
            </ControlTheme>

            <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Theme="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:vertical">
                    <Setter Property="Width" Value="6"/>
                </Style>
                <Style Selector="^:horizontal">
                    <Setter Property="Height" Value="6"/>
                </Style>
            </ControlTheme>

            <!-- Dashboard stat cards (applied via Classes). -->
            <!-- (class styles live below, outside Styles.Resources) -->

        </ResourceDictionary>
    </Styles.Resources>

    <!-- ============================================================
         Data-driven class styles (stand in for WPF DataTriggers)
         ============================================================ -->

    <!-- Severity value text: color tracks the metric's severity. -->
    <Style Selector="TextBlock.sevValue">
        <Setter Property="Foreground" Value="{DynamicResource SevLowBrush}"/>
    </Style>
    <Style Selector="TextBlock.sevValue.sevMid">
        <Setter Property="Foreground" Value="{DynamicResource SevMidBrush}"/>
    </Style>
    <Style Selector="TextBlock.sevValue.sevHigh">
        <Setter Property="Foreground" Value="{DynamicResource SevHighBrush}"/>
    </Style>
    <Style Selector="TextBlock.sevValue.sevCritical">
        <Setter Property="Foreground" Value="{DynamicResource SevCriticalBrush}"/>
    </Style>

    <!-- Activity dashboard: stat cards. -->
    <Style Selector="Border.statCard">
        <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="Margin" Value="3"/>
    </Style>
    <Style Selector="TextBlock.statLabel">
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Heatmap hover card (driven by the HeatmapTooltip behavior). -->
    <Style Selector="Border.heatTip">
        <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BoxShadow" Value="0 1 5 0 #1A000000"/>
    </Style>

    <!-- Heatmap day cell. Intensity level 0–4 maps to the accent at rising opacity. -->
    <Style Selector="Border.heat">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource BarEmptyBrush}"/>
    </Style>
    <Style Selector="Border.heat.lvl1">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Opacity" Value="0.30"/>
    </Style>
    <Style Selector="Border.heat.lvl2">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Border.heat.lvl3">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Opacity" Value="0.78"/>
    </Style>
    <Style Selector="Border.heat.lvl4">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Opacity" Value="1.0"/>
    </Style>

</Styles>
