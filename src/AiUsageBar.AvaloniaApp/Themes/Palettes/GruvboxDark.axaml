    <SolidColorBrush x:Key="Bg2Brush"           Color="#1D2021"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#3C3836"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#504945"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#EBDBB2"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#928374"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#83A598"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#504945"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#3C3836"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#B8BB26"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#FABD2F"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#FE8019"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#FB4934"/>
