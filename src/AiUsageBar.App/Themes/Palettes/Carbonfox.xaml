<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Carbonfox. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#393939"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#313131"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#474747"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#515151"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#f2f4f8"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#878889"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#33b1ff"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#616161"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#616161"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#42be65"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#f1c21b"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#F8A252"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#ff8389"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#ff8389"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#D75B61"/>
</ResourceDictionary>
