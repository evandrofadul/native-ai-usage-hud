<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vercel. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#000000"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#000000"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#0E0E0E"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#181818"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#ededed"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#878787"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#0070f3"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#282828"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#282828"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#46a758"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#ffb224"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#F27D38"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#e5484d"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#e5484d"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#BD2025"/>
</ResourceDictionary>
