    <SolidColorBrush x:Key="Bg2Brush"           Color="#16161E"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#24283B"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#2F3549"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#C0CAF5"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#565F89"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#7AA2F7"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#2F3549"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#24283B"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#9ECE6A"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#E0AF68"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#FF9E64"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#F7768E"/>
