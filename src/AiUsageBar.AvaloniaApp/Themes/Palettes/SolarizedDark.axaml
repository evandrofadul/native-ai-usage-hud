<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SolarizedDark. Generated from tools/palettes.json — do not edit by hand. -->
    <SolidColorBrush x:Key="BgBrush"            Color="#002B36"/>
    <SolidColorBrush x:Key="Bg2Brush"           Color="#00252E"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#073642"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#0A4452"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#93A1A1"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#586E75"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#268BD2"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#073642"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#073642"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#859900"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#B58900"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#CB4B16"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#DC322F"/>
    <SolidColorBrush x:Key="CloseHoverBrush"    Color="#DC322F"/>
    <SolidColorBrush x:Key="ClosePressedBrush"  Color="#B72824"/>
</ResourceDictionary>
