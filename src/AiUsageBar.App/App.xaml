<Application x:Class="AiUsageBar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active color palette; ThemeManager swaps this at
                     runtime. Controls.xaml references the palette via DynamicResource,
                     so styles update live when the palette is replaced. -->
                <ResourceDictionary Source="Themes/Palettes/OneDark.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
