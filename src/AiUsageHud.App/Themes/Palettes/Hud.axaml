    <SolidColorBrush x:Key="Bg3Brush"           Color="#161D2B"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#1F2838"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#E6EDF7"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#76849B"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#2BD4D9"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#20293A"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#19212F"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#4ADE80"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#F4C13D"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#FB923C"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#F26D7D"/>
