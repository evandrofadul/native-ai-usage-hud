<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- OneDark. Generated from tools/palettes.json — do not edit by hand. -->
    <SolidColorBrush x:Key="BgBrush"            Color="#282C34"/>
    <SolidColorBrush x:Key="Bg2Brush"           Color="#21252B"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#2C313A"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#323842"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#ABB2BF"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#5C6370"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#61AFEF"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#3E4451"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#3E4451"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#98C379"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#E5C07B"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#D19A66"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#E06C75"/>
    <SolidColorBrush x:Key="CloseHoverBrush"    Color="#E06C75"/>
    <SolidColorBrush x:Key="ClosePressedBrush"  Color="#BE5046"/>
</ResourceDictionary>
