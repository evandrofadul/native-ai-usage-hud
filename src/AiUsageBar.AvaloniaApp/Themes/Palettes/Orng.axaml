<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Orng. Generated from tools/palettes.json — do not edit by hand. -->
    <SolidColorBrush x:Key="BgBrush"            Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Bg2Brush"           Color="#020202"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#181818"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#222222"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#808080"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#EC5B2B"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#323232"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#323232"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#6BA1E6"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#EC5B2B"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#E66450"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#E06C75"/>
    <SolidColorBrush x:Key="CloseHoverBrush"    Color="#E06C75"/>
    <SolidColorBrush x:Key="ClosePressedBrush"  Color="#B8444D"/>
</ResourceDictionary>
