<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- FluentDark. Generated from tools/palettes.json — do not edit by hand. -->
    <SolidColorBrush x:Key="BgBrush"            Color="#202020"/>
    <SolidColorBrush x:Key="Bg2Brush"           Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#2D2D2D"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#383838"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#9D9D9D"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#60CDFF"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#393939"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#6CCB5F"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#FCE100"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#FF8C00"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#FF5459"/>
    <SolidColorBrush x:Key="CloseHoverBrush"    Color="#C42B1C"/>
    <SolidColorBrush x:Key="ClosePressedBrush"  Color="#A52317"/>
</ResourceDictionary>
