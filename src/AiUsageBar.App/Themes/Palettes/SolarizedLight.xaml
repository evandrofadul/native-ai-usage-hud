<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solarized Light — the light counterpart to Solarized Dark. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#FDF6E3"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#EEE8D5"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#E7E0CB"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#DDD6C1"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#657B83"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#93A1A1"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#268BD2"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#DDD6C1"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#E7E0CB"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#859900"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#B58900"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#CB4B16"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#DC322F"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#DC322F"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#B72824"/>
</ResourceDictionary>
