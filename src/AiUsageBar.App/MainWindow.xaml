<Window x:Class="AiUsageBar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AiUsageBar.App.ViewModels"
        xmlns:controls="clr-namespace:AiUsageBar.App.Controls"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Title="AI Usage Bar"
        MinWidth="350"
        MaxWidth="760"
        Width="445"
        MinHeight="100"
        ResizeMode="CanResize"
        SizeToContent="Height"
        Foreground="{DynamicResource FgBrush}"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.InputBindings>
        <KeyBinding Key="F5"
                    Command="{Binding RefreshActiveCommand}" />
        <KeyBinding Key="R"
                    Modifiers="Control"
                    Command="{Binding RefreshAllCommand}" />
    </Window.InputBindings>

    <Grid>
        <!-- Whole window is draggable; interactive controls (buttons, tabs) handle
         their own clicks first, so they aren't swallowed by the drag. -->
        <Border Background="{DynamicResource BgBrush}"
                Padding="0"
                CornerRadius="6">

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: title (left) + window controls (right) -->
                <Grid Grid.Row="0"
                      Margin="-12,-12,-12,0"
                      MouseLeftButtonDown="OnWindowMouseDown"
                      Background="Transparent">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12">
                        <Border Width="28"
                                Height="26"
                                CornerRadius="4"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="ai"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BgBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AI Usage"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource FgBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                        <Button Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource WindowControlButton}"
                                Width="45"
                                Height="32">
                            <fluent:SymbolIcon Symbol="Settings"
                                               IconVariant="Regular"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <ToggleButton x:Name="PinButton"
                                      Style="{StaticResource WindowToggleButton}"
                                      Checked="OnPinChanged"
                                      Unchecked="OnPinChanged"
                                      ToolTip="Keep on top (can't be minimized while pinned)"
                                      Width="45"
                                      Height="32">
                            <fluent:SymbolIcon Symbol="Pin"
                                               IconVariant="Regular"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource WindowControlButton}"
                                Click="OnMinimizeClick"
                                ToolTip="Minimize"
                                Width="45"
                                Height="32">
                            <fluent:SymbolIcon Symbol="Subtract"
                                               IconVariant="Regular"
                                               FontSize="15"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Click="OnCloseClick"
                                ToolTip="Close to tray"
                                Width="45"
                                Height="32">
                            <fluent:SymbolIcon Symbol="Dismiss"
                                               IconVariant="Regular"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Vendor tabs -->
                <TabControl Grid.Row="1"
                            ItemsSource="{Binding Tabs}"
                            SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="0">
                                <ItemsControl ItemsSource="{Binding Sections}"
                                              Margin="15,10,15,15" />
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Footer: status (left) + actions (right) -->
                <Grid Grid.Row="2"
                      Margin="0,10,0,0">
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource DimBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0" />
                    <Grid HorizontalAlignment="Stretch">
                        <Button Command="{Binding RefreshActiveCommand}"
                                Margin="0,0,6,0"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <fluent:SymbolIcon Symbol="ArrowSync"
                                                   IconVariant="Regular"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Refresh"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Resize grips. The 6px strips sit outside the 12px content inset, clear of
         the scrollbar and footer. Left/right adjust width (height stays auto until a
         vertical drag switches it to manual); the top/bottom edges + corners grow the
         window vertically with no height cap. The top edge stops short of the window
         control buttons on the right so it doesn't steal their clicks. -->
        <Rectangle Width="6"
                   HorizontalAlignment="Left"
                   Margin="0,6,0,6"
                   Fill="Transparent"
                   Cursor="SizeWE"
                   MouseLeftButtonDown="OnResizeLeft" />
        <Rectangle Width="6"
                   HorizontalAlignment="Right"
                   Margin="0,6,0,6"
                   Fill="Transparent"
                   Cursor="SizeWE"
                   MouseLeftButtonDown="OnResizeRight" />
        <Rectangle Height="6"
                   VerticalAlignment="Top"
                   Margin="6,0,184,0"
                   Fill="Transparent"
                   Cursor="SizeNS"
                   MouseLeftButtonDown="OnResizeTop" />
        <Rectangle Width="6"
                   Height="6"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Fill="Transparent"
                   Cursor="SizeNWSE"
                   MouseLeftButtonDown="OnResizeTopLeft" />
        <Rectangle Height="6"
                   VerticalAlignment="Bottom"
                   Margin="6,0,6,0"
                   Fill="Transparent"
                   Cursor="SizeNS"
                   MouseLeftButtonDown="OnResizeBottom" />
        <Rectangle Width="6"
                   Height="6"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Fill="Transparent"
                   Cursor="SizeNESW"
                   MouseLeftButtonDown="OnResizeBottomLeft" />
        <Rectangle Width="6"
                   Height="6"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Fill="Transparent"
                   Cursor="SizeNWSE"
                   MouseLeftButtonDown="OnResizeBottomRight" />

        <!-- Settings dialog overlay: dimmed backdrop + centered card. Clicking the
         backdrop (but not the card) dismisses it. -->
        <Border x:Name="SettingsBackdrop"
                Background="#99000000"
                CornerRadius="6"
                MouseLeftButtonDown="OnBackdropMouseDown"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource Bg2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <controls:SettingsView DataContext="{Binding SettingsVm}" />
            </Border>
        </Border>
    </Grid>
</Window>
