<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One Light (Atom). A bright counterpart to One Dark. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#EAEAEB"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#F0F0F1"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#E1E1E3"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#383A42"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#9D9DA3"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#4078F2"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#D3D3D5"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#D3D3D5"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#50A14F"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#C18401"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#D75F00"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#E45649"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#E45649"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#C73E36"/>
</ResourceDictionary>
