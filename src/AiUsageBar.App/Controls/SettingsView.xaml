<UserControl x:Class="AiUsageBar.App.Controls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AiUsageBar.Presentation.ViewModels;assembly=AiUsageBar.Presentation"
             xmlns:models="clr-namespace:AiUsageBar.Core.Models;assembly=AiUsageBar.Core"
             xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             mc:Ignorable="d"
             Foreground="{DynamicResource FgBrush}"
             FontFamily="Segoe UI"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <Grid RowDefinitions="Auto,*"
          Margin="5">


        <TextBlock Text="Settings"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="10,5"
                   Foreground="{DynamicResource FgBrush}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,0,0,10"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="320"
                        Margin="10,5,10,0">
                <!-- Primary vendor -->
                <TextBlock Text="PRIMARY VENDOR"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="{DynamicResource DimBrush}"
                           Margin="0,0,0,8" />
                <ComboBox Margin="0,0,0,6"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Vendors}"
                          SelectedItem="{Binding Primary, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Anthropic, OpenAI and Copilot sign in from their own local credential stores — no API keys needed here."
                           Foreground="{DynamicResource DimBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,0,5,22" />

                <!-- Theme -->
                <TextBlock Text="THEME"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="{DynamicResource DimBrush}"
                           Margin="0,0,0,8" />
                <ComboBox Margin="0,0,0,6"
                          HorizontalAlignment="Stretch"
                          MaxDropDownHeight="260"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding Theme, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- Background chip -->
                                <Border Width="16"
                                        Height="16"
                                        CornerRadius="3"
                                        Background="{Binding Background, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center" />
                                <!-- Accent dot -->
                                <Ellipse Width="11"
                                         Height="11"
                                         Fill="{Binding Accent, Converter={StaticResource HexToBrush}}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <!-- Severity dots: low / mid / high / critical -->
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{Binding SevLow, Converter={StaticResource HexToBrush}}"
                                         Margin="0,0,3,0"
                                         VerticalAlignment="Center" />
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{Binding SevMid, Converter={StaticResource HexToBrush}}"
                                         Margin="0,0,3,0"
                                         VerticalAlignment="Center" />
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{Binding SevHigh, Converter={StaticResource HexToBrush}}"
                                         Margin="0,0,3,0"
                                         VerticalAlignment="Center" />
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{Binding SevCritical, Converter={StaticResource HexToBrush}}"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Themes preview instantly; press Save to keep your choice."
                           Foreground="{DynamicResource DimBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,0,5,22" />

                <!-- Window transparency -->
                <TextBlock Text="WINDOW TRANSPARENCY"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="{DynamicResource DimBrush}"
                           Margin="0,0,0,8" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0"
                            Style="{StaticResource ThemedSlider}"
                            Minimum="10"
                            Maximum="100"
                            Value="{Binding Opacity, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="12,0,2,0"
                               MinWidth="34"
                               TextAlignment="Right"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource FgBrush}">
                        <Run Text="{Binding Opacity, Mode=OneWay}" /><Run Text="%" />
                    </TextBlock>
                </Grid>

                <TextBlock Text="Lower values make the whole window see-through (10–100%)."
                           Foreground="{DynamicResource DimBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,0,5,12" />

                <!-- Apply-to-tray switch -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0"
                               FontSize="12"
                               Foreground="{DynamicResource FgBrush}"
                               Text="Also apply to the tray popup &amp; menu" />
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding OpacityAffectsTray, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="When on, the tray's hover card and right-click menu use the same transparency."
                           Foreground="{DynamicResource DimBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,0,5,22" />

                <!-- Actions -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,5,0,0">
                    <Button Command="{Binding CancelCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon Symbol="Dismiss"
                                               IconVariant="Regular"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Close"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}"
                            IsDefault="True"
                            Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <fluent:SymbolIcon Symbol="Save"
                                               IconVariant="Regular"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Save"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--<TextBlock Text="{Binding Status}"
                           Foreground="{DynamicResource DimBrush}"
                           FontSize="11"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap" />-->
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
