<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Catppuccin Latte — the light Catppuccin flavour. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#EFF1F5"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#E6E9EF"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#DCE0E8"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#CCD0DA"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#4C4F69"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#8C8FA1"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#1E66F5"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#CCD0DA"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#CCD0DA"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#40A02B"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#DF8E1D"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#FE640B"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#D20F39"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#D20F39"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#B00C30"/>
</ResourceDictionary>
