<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AiUsageHud.Presentation.ViewModels;assembly=AiUsageHud.Presentation"
             xmlns:models="clr-namespace:AiUsageHud.Core.Models;assembly=AiUsageHud.Core"
             x:Class="AiUsageHud.App.Controls.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Foreground="{DynamicResource FgBrush}"
             FontFamily="Segoe UI">

    <Grid RowDefinitions="Auto,*,Auto" Margin="5">

        <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" Margin="10,5"
                   Foreground="{DynamicResource FgBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="320" Margin="10,5,10,0">

                <!-- Visible providers multi-select dropdown -->
                <TextBlock Text="VISIBLE PROVIDERS" FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <ToggleButton Name="VendorDropdownBtn"
                                  IsChecked="{Binding IsVendorDropdownOpen, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Theme="{StaticResource DropdownHeaderToggle}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding VendorSummary}"
                                       VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource FgBrush}"/>
                            <Path Grid.Column="1" Margin="0,0,2,0"
                                  Width="10" Height="6" Stretch="Fill"
                                  Fill="{DynamicResource DimBrush}" Data="M 0 0 L 5 5 L 10 0 Z"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsVendorDropdownOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding #VendorDropdownBtn}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True">
                        <Border Margin="0,4,0,0"
                                MinWidth="{Binding #VendorDropdownBtn.Bounds.Width}"
                                Background="{DynamicResource Bg2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                BoxShadow="0 2 8 0 #33000000">
                            <ScrollViewer Margin="0,3" MaxHeight="220">
                                <ItemsControl ItemsSource="{Binding VendorOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VendorSettingItemVm">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Theme="{StaticResource VendorCheckMenuItem}">
                                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="4,1">
                                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                                                            Background="{DynamicResource Bg3Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <PathIcon Data="{StaticResource IconCheck}"
                                                                  Width="10" Height="10"
                                                                  Foreground="{DynamicResource AccentBrush}"
                                                                  IsVisible="{Binding IsEnabled}"/>
                                                    </Border>
                                                    <PathIcon Grid.Column="1"
                                                              Data="{Binding Vendor, Converter={StaticResource VendorIcon}}"
                                                              Width="14" Height="14"
                                                              Margin="0,0,8,0"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource DimBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Label}"
                                                               VerticalAlignment="Center" FontSize="13"
                                                               Foreground="{DynamicResource FgBrush}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Text="Select which providers appear in the HUD tabs and tray. At least one must be active."
                           Foreground="{DynamicResource DimBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,0,5,22"/>

                <!-- Primary vendor -->
                <TextBlock Text="PRIMARY VENDOR" FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" Margin="0,0,0,8"/>
                <ComboBox Margin="0,0,0,6" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailablePrimaryVendors}"
                          SelectedItem="{Binding Primary, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VendorId">
                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="The default tab opened at startup and displayed as the primary tray metric."
                           Foreground="{DynamicResource DimBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,0,5,22"/>

                <!-- Theme -->
                <TextBlock Text="THEME" FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" Margin="0,0,0,8"/>
                <ComboBox Margin="0,0,0,6" HorizontalAlignment="Stretch" MaxDropDownHeight="260"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding Theme, Mode=TwoWay, Converter={StaticResource ThemeIdToOption}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOption">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="16" Height="16" CornerRadius="3"
                                        Background="{Binding Background, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <Ellipse Width="11" Height="11"
                                         Fill="{Binding Accent, Converter={StaticResource HexToBrush}}"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Ellipse Width="9" Height="9"
                                         Fill="{Binding SevLow, Converter={StaticResource HexToBrush}}"
                                         Margin="0,1,3,0" VerticalAlignment="Center"/>
                                <Ellipse Width="9" Height="9"
                                         Fill="{Binding SevMid, Converter={StaticResource HexToBrush}}"
                                         Margin="0,1,3,0" VerticalAlignment="Center"/>
                                <Ellipse Width="9" Height="9"
                                         Fill="{Binding SevHigh, Converter={StaticResource HexToBrush}}"
                                         Margin="0,1,3,0" VerticalAlignment="Center"/>
                                <Ellipse Width="9" Height="9"
                                         Fill="{Binding SevCritical, Converter={StaticResource HexToBrush}}"
                                         Margin="0,1,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Themes preview instantly; press Save to keep your choice."
                           Foreground="{DynamicResource DimBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,0,5,22"/>

                <!-- Window transparency — Windows only (also dims the custom Win32 tray UI). -->
                <StackPanel IsVisible="{Binding IsWindows}">
                    <TextBlock Text="WINDOW TRANSPARENCY" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource DimBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,2" ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Theme="{StaticResource ThemedSlider}"
                                Minimum="10" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,2,0"
                                   MinWidth="34" TextAlignment="Right" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource FgBrush}"
                                   Text="{Binding Opacity, StringFormat='{}{0}%'}"/>
                    </Grid>

                    <TextBlock Text="Lower values make the whole window see-through (10–100%)."
                               Foreground="{DynamicResource DimBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,0,5,12"/>

                    <!-- Apply-to-tray switch -->
                    <Grid Margin="0,0,0,2" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource FgBrush}"
                                   Text="Also apply to the tray popup &amp; menu"/>
                        <ToggleButton Grid.Column="1" Theme="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding OpacityAffectsTray, Mode=TwoWay}"/>
                    </Grid>

                    <TextBlock Text="When on, the tray's hover card and right-click menu use the same transparency."
                               Foreground="{DynamicResource DimBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,0,5,22"/>
                </StackPanel>

                <!-- Launch at login -->
                <TextBlock Text="STARTUP" FontWeight="Bold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,2" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource FgBrush}"
                               Text="Start automatically on login"/>
                    <ToggleButton Grid.Column="1" Theme="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Text="Launches AI Usage Bar to the tray when you sign in to your computer."
                           Foreground="{DynamicResource DimBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,0,5,22"/>
            </StackPanel>
        </ScrollViewer>

		<!-- Actions -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
			<Button Command="{Binding CancelCommand}" Margin="0,0,8,0">
				<StackPanel Orientation="Horizontal">
					<PathIcon Data="{StaticResource IconDismiss}" Width="10" Height="10"
							  VerticalAlignment="Center"
							  Foreground="{Binding $parent[Button].Foreground}"/>
					<TextBlock Text="Close" Margin="6,0,0,0" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button Command="{Binding SaveCommand}" IsDefault="True"
					Theme="{StaticResource AccentButton}">
				<StackPanel Orientation="Horizontal">
					<PathIcon Data="{StaticResource IconSave}" Width="13" Height="13"
							  VerticalAlignment="Center"
							  Foreground="{Binding $parent[Button].Foreground}"/>
					<TextBlock Text="Save" Margin="6,0,0,0" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</StackPanel>
    </Grid>
</UserControl>
