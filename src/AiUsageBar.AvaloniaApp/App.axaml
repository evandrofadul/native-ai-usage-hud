<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AiUsageBar.AvaloniaApp.App">
    <!-- SimpleTheme is used ONLY as structural plumbing for controls we don't draw
         ourselves (ScrollViewer/ItemsControl/ScrollContentPresenter). Controls.axaml
         comes AFTER it and re-templates every visible control to match the WPF look,
         so SimpleTheme's own appearance never shows through. -->
    <Application.Styles>
        <SimpleTheme/>
        <StyleInclude Source="avares://AiUsageBar/Themes/Controls.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active color palette; AvaloniaThemeService swaps it at
                     runtime. The control styles reference the palette via DynamicResource,
                     so the UI recolors live when the palette is replaced. -->
                <ResourceInclude Source="avares://AiUsageBar/Themes/Palettes/OneDark.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
