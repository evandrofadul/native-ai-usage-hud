<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nord — arctic, bluish dark palette. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#2E3440"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#272B35"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#3B4252"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#434C5E"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#D8DEE9"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#6C7589"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#88C0D0"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#434C5E"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#3B4252"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#A3BE8C"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#EBCB8B"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#D08770"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#BF616A"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#BF616A"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#A54852"/>
</ResourceDictionary>
