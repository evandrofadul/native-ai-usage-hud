<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AiUsageBar.Core\AiUsageBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentIcons.Wpf" Version="2.1.328" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>AiUsageBar</AssemblyName>
    <AssemblyTitle>AI Usage Bar</AssemblyTitle>
    <Product>AI Usage Bar</Product>
    <Description>System-tray monitor for Anthropic Claude, OpenAI Codex, GitHub Copilot, Z.AI and OpenRouter plan usage.</Description>
    <Authors>Evandro Fadul</Authors>
    <Company>Evandro Fadul</Company>
    <Copyright>Copyright © 2026 Evandro Fadul</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
