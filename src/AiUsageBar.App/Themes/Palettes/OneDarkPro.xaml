<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One Dark Pro. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#1e222a"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#161A22"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#2C3038"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#363A42"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#abb2bf"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#595E69"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#61afef"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#464A52"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#464A52"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#98c379"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#e5c07b"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#E29678"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#e06c75"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#e06c75"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#B8444D"/>
</ResourceDictionary>
