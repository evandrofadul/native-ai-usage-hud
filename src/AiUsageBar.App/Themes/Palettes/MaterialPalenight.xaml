<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Material Palenight — the popular Material Theme variant. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#292D3E"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#222637"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#34394D"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#3C4254"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#A6ACCD"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#676E95"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#82AAFF"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#3C4254"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#34394D"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#C3E88D"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#FFCB6B"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#F78C6C"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#FF5370"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#FF5370"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#E04860"/>
</ResourceDictionary>
