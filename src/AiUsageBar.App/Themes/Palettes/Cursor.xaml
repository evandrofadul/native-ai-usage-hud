<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cursor. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#181818"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#101010"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#262626"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#303030"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#e4e4e4"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#6E6E6E"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#88c0d0"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#404040"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#404040"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#3fa266"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#f1b467"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#EA7D6C"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#e34671"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#e34671"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#BB1E49"/>
</ResourceDictionary>
