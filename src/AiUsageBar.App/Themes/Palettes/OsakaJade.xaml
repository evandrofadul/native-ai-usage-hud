<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Osaka Jade. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#111c18"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#091410"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#1F2A26"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#293430"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#c1c497"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#53685b"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#2dd5b7"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#394440"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#394440"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#549e6a"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#e5c736"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#F28D3E"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#ff5345"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#ff5345"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#D72B1D"/>
</ResourceDictionary>
