<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- EverforestDark. Generated from tools/palettes.json — do not edit by hand. -->
    <SolidColorBrush x:Key="BgBrush"            Color="#2D353B"/>
    <SolidColorBrush x:Key="Bg2Brush"           Color="#272E33"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#343F44"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#3D484D"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#D3C6AA"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#859289"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#7FBBB3"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#3D484D"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#343F44"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#A7C080"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#DBBC7F"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#E69875"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#E67E80"/>
    <SolidColorBrush x:Key="CloseHoverBrush"    Color="#E67E80"/>
    <SolidColorBrush x:Key="ClosePressedBrush"  Color="#CC6668"/>
</ResourceDictionary>
