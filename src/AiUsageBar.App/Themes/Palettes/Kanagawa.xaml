<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kanagawa — muted, ink-wash inspired dark palette. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#1F1F28"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#16161D"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#2A2A37"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#363646"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#DCD7BA"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#727169"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#7E9CD8"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#2A2A37"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#2A2A37"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#98BB6C"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#E6C384"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#FFA066"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#FF5D62"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#FF5D62"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#E04A50"/>
</ResourceDictionary>
