    <SolidColorBrush x:Key="Bg2Brush"           Color="#080707"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#1E1D1D"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#282727"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#CECDC3"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#6F6E69"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#DA702C"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#383737"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#383737"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#879A39"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#DA702C"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#D65E36"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#D14D41"/>
    <SolidColorBrush x:Key="CloseHoverBrush"    Color="#D14D41"/>
    <SolidColorBrush x:Key="ClosePressedBrush"  Color="#A92519"/>
</ResourceDictionary>
