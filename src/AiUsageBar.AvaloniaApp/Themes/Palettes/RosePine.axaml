    <SolidColorBrush x:Key="Bg2Brush"           Color="#1F1D2E"/>
    <SolidColorBrush x:Key="Bg3Brush"           Color="#26233A"/>
    <SolidColorBrush x:Key="HoverBrush"         Color="#2A283E"/>
    <SolidColorBrush x:Key="FgBrush"            Color="#E0DEF4"/>
    <SolidColorBrush x:Key="DimBrush"           Color="#6E6A86"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#C4A7E7"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#26233A"/>
    <SolidColorBrush x:Key="BarEmptyBrush"      Color="#26233A"/>
    <SolidColorBrush x:Key="SevLowBrush"        Color="#9CCFD8"/>
    <SolidColorBrush x:Key="SevMidBrush"        Color="#F6C177"/>
    <SolidColorBrush x:Key="SevHighBrush"       Color="#EBBCBA"/>
    <SolidColorBrush x:Key="SevCriticalBrush"   Color="#EB6F92"/>
    <SolidColorBrush x:Key="CloseHoverBrush"    Color="#EB6F92"/>
    <SolidColorBrush x:Key="ClosePressedBrush"  Color="#D1577D"/>
</ResourceDictionary>
