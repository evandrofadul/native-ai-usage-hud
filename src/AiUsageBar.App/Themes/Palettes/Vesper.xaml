<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vesper. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#101010"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#080808"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#1E1E1E"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#282828"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#ffffff"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#8b8b8b"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#ffc799"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#383838"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#383838"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#99ffe4"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#ffc799"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#FFA48C"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#ff8080"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#ff8080"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#D75858"/>
</ResourceDictionary>
