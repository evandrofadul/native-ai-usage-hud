<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Surfaces trim/AOT/single-file analyzer warnings at build time and marks the
         assembly trimmable, so the Native-AOT head can link it cleanly. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Library: not a publish target on its own. A solution-level `dotnet publish`
         then publishes only the app head; this is still pulled in as its dependency. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

</Project>
