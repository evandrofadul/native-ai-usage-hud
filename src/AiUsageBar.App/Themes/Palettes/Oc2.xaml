<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- OC-2. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#1f1f1f"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#171717"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#2D2D2D"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#373737"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#f1ece8"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#707070"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#fab283"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#474747"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#474747"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#12c905"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#fcd53a"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#FC943A"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#fc533a"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#fc533a"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#D42B12"/>
</ResourceDictionary>
