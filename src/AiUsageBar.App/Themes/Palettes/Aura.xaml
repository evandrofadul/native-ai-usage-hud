<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aura. Adapted from the OpenCode theme of the same name; surface shades derived from the base. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#15141b"/>
    <SolidColorBrush x:Key="Bg2Brush"         Color="#0D0C13"/>
    <SolidColorBrush x:Key="Bg3Brush"         Color="#232229"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#2D2C33"/>
    <SolidColorBrush x:Key="FgBrush"          Color="#edecee"/>
    <SolidColorBrush x:Key="DimBrush"         Color="#706F74"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#a277ff"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#3D3C43"/>
    <SolidColorBrush x:Key="BarEmptyBrush"    Color="#3D3C43"/>

    <SolidColorBrush x:Key="SevLowBrush"      Color="#61ffca"/>
    <SolidColorBrush x:Key="SevMidBrush"      Color="#ffca85"/>
    <SolidColorBrush x:Key="SevHighBrush"     Color="#FF9876"/>
    <SolidColorBrush x:Key="SevCriticalBrush" Color="#ff6767"/>

    <SolidColorBrush x:Key="CloseHoverBrush"   Color="#ff6767"/>
    <SolidColorBrush x:Key="ClosePressedBrush" Color="#D73F3F"/>
</ResourceDictionary>
